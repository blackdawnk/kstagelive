---
import Base from '../../layouts/Base.astro';
import { loadSnapshot, formatDateRange, tidyVenueName } from '../../lib/data';
import type { Performance, Venue } from '../../lib/data';
import { areaEn, genreEn, stateEn, stateSlug } from '../../lib/i18n/codes';
import { parseTitle } from '../../lib/i18n/places';
import { romanize, romanizePersonName } from '../../lib/i18n/romanize';
import { formatPrice, formatSchedule, formatAgeLimit, formatRuntime } from '../../lib/i18n/format';

export async function getStaticPaths() {
  const snapshot = loadSnapshot();
  return snapshot.performances.map((p) => ({
    params: { id: p.id },
    props: { performance: p, venue: p.venueId ? snapshot.venues[p.venueId] ?? null : null },
  }));
}

interface Props {
  performance: Performance;
  venue: Venue | null;
}

const { performance: p, venue } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = stateSlug(p.state);

const parsed = parseTitle(p.title);
const venueName = tidyVenueName(p.venueName);
const venueLatin = romanize(venueName);

/**
 * Facts are shown in English with the Korean kept alongside — the visitor needs
 * the original to search a ticket site or show it to someone here.
 * `original` is set only when we actually converted something.
 */
interface Fact {
  label: string;
  /** Shown first. */
  value: string;
  /** Shown beneath, smaller. */
  sub?: string;
  /** Language of `value` — Korean values get lang="ko" for correct rendering. */
  valueLang?: 'ko';
}

const facts: Fact[] = [];

/** Converted fields lead with English and keep the filed Korean underneath. */
const addConverted = (
  label: string,
  raw: string | null | undefined,
  fmt: (s: string) => { text: string; translated: boolean },
) => {
  const src = (raw ?? '').trim();
  if (!src) return;
  const { text, translated } = fmt(src);
  facts.push({ label, value: text, sub: translated ? src : undefined, valueLang: translated ? undefined : 'ko' });
};

/** Proper nouns lead with the Korean; the Latin reading is the aid. */
const addName = (label: string, raw: string | null | undefined) => {
  const src = (raw ?? '').trim();
  if (!src) return;
  const latin = romanize(src);
  facts.push({ label, value: src, sub: latin ?? undefined, valueLang: 'ko' });
};

addConverted('Tickets', p.priceGuide, formatPrice);
addConverted('Showtimes', p.scheduleGuide, formatSchedule);
addConverted('Running time', p.runtime, formatRuntime);
addConverted('Age rating', p.ageLimit, formatAgeLimit);
addName('Production', p.producer);
if (p.host && p.host !== p.producer) addName('Presented by', p.host);
---

<Base title={`${p.title} — kstagelive`} description={`${p.title} at ${p.venueName}, ${areaEn(p.area)}.`}>
  <article class="wrap detail">
    <p class="crumbs dim"><a href={`${base}/`}>Performances</a> <span aria-hidden="true">›</span> {areaEn(p.area)}</p>

    {/* Korean title first — it is the searchable, authoritative string (AC15). */}
    <h1 lang="ko" class="title">{parsed.title}</h1>

    <p class="tags">
      <span class={`chip status-${slug}`}>{stateEn(p.state) || 'Status unknown'}</span>
      {parsed.places.map((place) => <span class="chip chip-place">{place}</span>)}
      {p.genre && <span class="chip">{genreEn(p.genre)}</span>}
      {p.isFestival && <span class="chip">Festival</span>}
      {p.isVisiting && <span class="chip">International act</span>}
      {p.openRun && <span class="chip">Open run</span>}
    </p>

    <p class="when">{formatDateRange(p.startDate, p.endDate)}</p>
    <p class="where muted">
      <span lang="ko">{venueName}</span>
      {venueLatin && venueLatin !== venueName && <span class="dim"> · {venueLatin}</span>}
      <span class="dim"> · {areaEn(p.area)}</span>
    </p>

    {p.cast?.length > 0 && (
      <section class="block">
        <h2>Line-up</h2>
        {/* prfcast carries real names; SP05 found idol members listed in full. */}
        <ul class="cast">
          {p.cast.map((name) => {
            const latin = romanizePersonName(name);
            return (
              <li class="chip cast-chip">
                <span lang="ko">{name}</span>
                {latin && latin !== name && <span class="latin dim">{latin}</span>}
              </li>
            );
          })}
        </ul>
      </section>
    )}

    {facts.length > 0 && (
      <section class="block">
        <h2>Details</h2>
        <dl class="facts">
          {facts.map((f) => (
            <div class="fact">
              <dt class="dim">{f.label}</dt>
              <dd>
                <span lang={f.valueLang}>{f.value}</span>
                {f.sub && <span class="sub dim" lang={f.valueLang ? undefined : 'ko'}>{f.sub}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <section class="block">
      <h2>Tickets</h2>
      {p.ticketLinks?.length > 0 ? (
        <>
          <ul class="tickets">
            {p.ticketLinks.map((link) => (
              <li>
                {/*
                  AC08 — these are anchors, never fetches. We do not check, ping
                  or crawl seller hosts: Interpark's robots.txt bans crawlers.
                */}
                <a class="ticket-link" href={link.url} rel="noopener nofollow external" target="_blank">
                  <span lang="ko">{link.name || 'Official seller'}</span>
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="caveat dim">
            Links go to the seller named by the organiser. kstagelive does not sell tickets,
            process payments or handle bookings, and cannot guarantee that a seller accepts
            overseas cards or non-Korean accounts.
          </p>
        </>
      ) : (
        <p class="caveat dim">
          No official seller is listed for this performance yet. That does not mean tickets
          are unnecessary — check the organiser's own channels.
        </p>
      )}

      {/* AC07 — be explicit about the one thing this site cannot tell you. */}
      <p class="caveat dim">
        <strong>On-sale dates are not available here.</strong> KOPIS registers a performance
        only after ticketing has begun, so this site cannot announce when sales open.
      </p>
    </section>

    {venue && (
      <section class="block">
        <h2>Venue</h2>
        <div class="card venue-card">
          <h3 lang="ko">
            <a href={`${base}/venue/${venue.id}`}>{venue.name}</a>
          </h3>
          {venue.address && <p class="muted" lang="ko">{venue.address}</p>}
          <p class="dim">
            {venue.seatCount && <>{venue.seatCount.toLocaleString()} seats · </>}
            {venue.hallCount && <>{venue.hallCount} halls · </>}
            {venue.openedYear && <>opened {venue.openedYear}</>}
          </p>
          <p><a href={`${base}/venue/${venue.id}`}>Venue details, access and map →</a></p>
        </div>
      </section>
    )}

    {p.firstRegisteredAt && (
      <p class="reg dim mono">
        Registered with KOPIS {p.firstRegisteredAt.slice(0, 10)}
        {p.updatedAt && <> · last updated {p.updatedAt.slice(0, 10)}</>}
      </p>
    )}
  </article>
</Base>

<style>
  .detail { padding-block: 36px 24px; max-width: 820px; }
  .crumbs { font-size: 0.85rem; margin-bottom: 14px; }
  .crumbs a { color: var(--text-muted); text-decoration: none; }
  .crumbs a:hover { color: var(--neon-cyan); }

  .title { font-size: clamp(1.7rem, 4.5vw, 2.6rem); word-break: keep-all; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 18px; }
  .when { font-size: 1.15rem; font-weight: 700; color: var(--neon-cyan); margin: 0 0 4px; }
  .where { margin: 0 0 8px; }

  .block { margin-top: 34px; }
  .block h2 { font-size: 1.15rem; margin-bottom: 12px; }

  .cast { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .cast-chip { flex-direction: column; align-items: flex-start; gap: 0; padding: 5px 12px; }
  .cast-chip .latin { font-size: 0.74rem; line-height: 1.3; }

  .facts { margin: 0; display: grid; gap: 12px; }
  .fact { display: grid; grid-template-columns: 150px 1fr; gap: 12px; }
  .fact dt { font-size: 0.85rem; }
  .fact dd { margin: 0; }
  .fact .sub { display: block; font-size: 0.82rem; margin-top: 2px; }
  .chip-place { border-color: color-mix(in srgb, var(--neon-purple) 45%, var(--border)); color: var(--neon-purple); }
  @media (max-width: 560px) {
    .fact { grid-template-columns: 1fr; gap: 2px; }
  }

  .tickets { list-style: none; padding: 0; margin: 0 0 12px; display: flex; flex-wrap: wrap; gap: 10px; }
  .ticket-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 18px;
    border-radius: var(--radius-sm);
    background: var(--grad-stage);
    color: #12001a;
    font-weight: 750;
    text-decoration: none;
  }
  .ticket-link:hover { filter: brightness(1.12); color: #12001a; }
  .arrow { font-weight: 500; }

  .caveat { font-size: 0.85rem; max-width: 68ch; margin: 8px 0 0; }
  .caveat strong { color: var(--text-muted); }

  .venue-card h3 { margin-bottom: 4px; }
  .venue-card p { margin: 4px 0; font-size: 0.9rem; }

  .reg { margin-top: 40px; font-size: 0.8rem; }

  .status-upcoming { border-color: color-mix(in srgb, var(--status-upcoming) 45%, var(--border)); color: var(--status-upcoming); }
  .status-running { border-color: color-mix(in srgb, var(--status-running) 45%, var(--border)); color: var(--status-running); }
  .status-ended { color: var(--status-ended); }
</style>
