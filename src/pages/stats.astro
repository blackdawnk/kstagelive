---
import Base from '../layouts/Base.astro';
import { loadSnapshot, freshness } from '../lib/data';
import { areaEn } from '../lib/i18n/codes';
import { castCoverage } from '../lib/artist';

const snapshot = loadSnapshot();
const fresh = freshness(snapshot);
const perfs = snapshot.performances;
const coverage = castCoverage(snapshot);

function tally(pick: (p: (typeof perfs)[number]) => string | null | undefined) {
  const m = new Map<string, number>();
  for (const p of perfs) {
    const k = pick(p);
    if (k) m.set(k, (m.get(k) ?? 0) + 1);
  }
  return [...m.entries()].sort((a, b) => b[1] - a[1]);
}

const byArea = tally((p) => p.area);
const byMonth = [...tally((p) => p.startDate?.slice(0, 7))].sort((a, b) => a[0].localeCompare(b[0]));
const maxArea = Math.max(1, ...byArea.map(([, n]) => n));
const maxMonth = Math.max(1, ...byMonth.map(([, n]) => n));

const withTickets = perfs.filter((p) => p.ticketLinks?.length > 0).length;
const withPrice = perfs.filter((p) => p.priceGuide).length;
const withVenue = perfs.filter((p) => p.venueId).length;
const lead = snapshot.leadTimeDays;

const pct = (n: number) => (perfs.length ? Math.round((n / perfs.length) * 100) : 0);
const monthLabel = (ym: string) => {
  const [y, m] = ym.split('-');
  return `${['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][Number(m) - 1]} ${y.slice(2)}`;
};
---

<Base title="Charts — kstagelive" description="Korean live-music market data: regional spread, monthly volume and catalogue coverage.">
  <section class="wrap head">
    <h1>Charts</h1>
    <p class="lede muted">
      What the statutory record actually contains. {perfs.length.toLocaleString()} popular-music
      performances registered between {snapshot.source.window.start} and {snapshot.source.window.end}.
    </p>
    <p class="dim">Snapshot {snapshot.snapshotId} · checked {fresh.checkedAtLabel}</p>
  </section>

  <section class="wrap block">
    <h2>Where performances happen</h2>
    <ul class="bars">
      {byArea.map(([area, n]) => (
        <li class="bar-row">
          <span class="bar-label">{areaEn(area)}</span>
          <span class="bar-track"><span class="bar-fill" style={`width:${(n / maxArea) * 100}%`}></span></span>
          <span class="bar-value mono">{n.toLocaleString()}</span>
        </li>
      ))}
    </ul>
    <p class="note dim">
      Seoul's dominance is real, not a sampling artefact — registration is a legal requirement
      nationwide, so this is the whole picture rather than a selection.
    </p>
  </section>

  <section class="wrap block">
    <h2>Performances by month</h2>
    <ul class="bars">
      {byMonth.map(([ym, n]) => (
        <li class="bar-row">
          <span class="bar-label mono">{monthLabel(ym)}</span>
          <span class="bar-track"><span class="bar-fill alt" style={`width:${(n / maxMonth) * 100}%`}></span></span>
          <span class="bar-value mono">{n.toLocaleString()}</span>
        </li>
      ))}
    </ul>
    <p class="note dim">
      Later months look thinner because registration happens close to the show, not because
      fewer concerts are planned — see below.
    </p>
  </section>

  <section class="wrap block">
    <h2>How far ahead shows are registered</h2>
    <div class="cards">
      <div class="card stat">
        <p class="stat-value">{lead.median ?? '—'}</p>
        <p class="stat-label dim">median days before opening</p>
      </div>
      <div class="card stat">
        <p class="stat-value">{lead.p10 ?? '—'}</p>
        <p class="stat-label dim">10th percentile</p>
      </div>
      <div class="card stat">
        <p class="stat-value">{lead.p90 ?? '—'}</p>
        <p class="stat-label dim">90th percentile</p>
      </div>
    </div>
    <p class="note dim">
      KOPIS registers a performance only after ticket sales have started, so this is a
      measure of how much notice the record gives — not of when tickets went on sale.
      Large tours register far earlier than club nights, which is why the spread is wide.
      Measured across {lead.count?.toLocaleString?.() ?? lead.count} performances.
    </p>
  </section>

  <section class="wrap block">
    <h2>Catalogue coverage</h2>
    <ul class="bars">
      {[
        ['Official ticket link', withTickets],
        ['Venue record', withVenue],
        ['Cast listed', coverage.performancesWithCast],
        ['Price guide', withPrice],
      ].map(([label, n]) => (
        <li class="bar-row">
          <span class="bar-label">{label}</span>
          <span class="bar-track"><span class="bar-fill" style={`width:${pct(n as number)}%`}></span></span>
          <span class="bar-value mono">{pct(n as number)}%</span>
        </li>
      ))}
    </ul>
    <p class="note dim">
      Published so you can see where the data thins out. A missing field means the organiser
      did not file it — it does not mean the performance lacks that thing.
    </p>
  </section>
</Base>

<style>
  .head { padding-block: 52px 20px; }
  .lede { max-width: 62ch; font-size: 1.05rem; margin-block: 0 0.5rem; }
  .head .dim { font-size: 0.85rem; }

  .block { margin-top: 44px; }
  .block h2 { font-size: 1.15rem; margin-bottom: 14px; }

  .bars { list-style: none; padding: 0; margin: 0; display: grid; gap: 7px; }
  .bar-row { display: grid; grid-template-columns: 150px 1fr 64px; align-items: center; gap: 12px; font-size: 0.9rem; }
  .bar-label { color: var(--text-muted); }
  .bar-track { background: var(--surface-2); border-radius: 999px; height: 12px; overflow: hidden; }
  .bar-fill { display: block; height: 100%; background: var(--grad-stage); border-radius: 999px; min-width: 2px; }
  .bar-fill.alt { background: linear-gradient(90deg, var(--neon-cyan), var(--neon-purple)); }
  .bar-value { text-align: right; color: var(--text-muted); }
  @media (max-width: 560px) {
    .bar-row { grid-template-columns: 110px 1fr 52px; gap: 8px; font-size: 0.82rem; }
  }

  .cards { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); }
  .stat { text-align: center; }
  .stat-value { font-size: 2.2rem; font-weight: 800; margin: 0; color: var(--neon-cyan); line-height: 1.1; }
  .stat-label { margin: 4px 0 0; font-size: 0.82rem; }

  .note { font-size: 0.85rem; max-width: 68ch; margin-top: 12px; }
</style>
