---
import Base from '../layouts/Base.astro';
import PerformanceCard from '../components/PerformanceCard.astro';
import { loadSnapshot, freshness } from '../lib/data';
import { buildIdolIndex } from '../lib/idol';

const snapshot = loadSnapshot();
const { groups, idolPerformances } = buildIdolIndex(snapshot);
const fresh = freshness(snapshot);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const today = new Date().toISOString().slice(0, 10);
const upcomingIdol = idolPerformances
  .filter((p) => (p.endDate ?? p.startDate ?? '') >= today)
  .sort((a, b) => (a.startDate ?? '9999').localeCompare(b.startDate ?? '9999'));
const soon = upcomingIdol.slice(0, 12);

const soloShows = groups.reduce(
  (n, g) => n + [...g.memberPerformances.values()].reduce((m, l) => m + l.length, 0),
  0,
);
const topGroups = groups.slice(0, 14);
---

<Base
  title="kstagelive — K-pop concerts in Korea, in English"
  description="K-pop concerts, fan meetings and fan-cons in Korea, in English: group and member schedules, venue access and official ticket links."
>
  <section class="wrap hero">
    <h1>
      K-pop, live in Korea.<br /><span class="gradient-text">In English.</span>
    </h1>
    <p class="lede muted">
      Concerts, fan meetings and fan-cons — by group and by member, with venue access
      details and official ticket links.
    </p>
    <p class="src dim">
      Built on KOPIS, Korea's statutory performance database. Every ticketed show is
      registered there by law, so nothing gets missed — and nothing is a rumour.
    </p>

    <div class="stats">
      <a class="stat" href={`${base}/performances`}>
        <span class="stat-n">{upcomingIdol.length}</span>
        <span class="stat-l dim">upcoming idol shows</span>
      </a>
      <a class="stat" href={`${base}/groups`}>
        <span class="stat-n">{groups.length}</span>
        <span class="stat-l dim">groups</span>
      </a>
      <a class="stat" href={`${base}/groups`}>
        <span class="stat-n">{soloShows}</span>
        <span class="stat-l dim">solo &amp; unit dates</span>
      </a>
    </div>
  </section>

  <section class="wrap">
    <div class="bar">
      <h2>Next up</h2>
      <p class="dim freshness">Checked {fresh.checkedAtLabel}{fresh.isStale && ' · may be out of date'}</p>
    </div>
    {soon.length > 0 ? (
      <>
        <div class="grid">
          {soon.map((p) => <PerformanceCard performance={p} href={`${base}/performance/${p.id}`} />)}
        </div>
        <p class="more">
          <a class="btn" href={`${base}/performances`}>All {upcomingIdol.length} idol shows →</a>
        </p>
      </>
    ) : (
      <p class="card">No upcoming idol shows in the current snapshot.</p>
    )}
  </section>

  <section class="wrap block">
    <div class="bar">
      <h2>Groups</h2>
      <p class="dim"><a href={`${base}/groups`}>See all {groups.length} →</a></p>
    </div>
    <nav class="chips" aria-label="Groups">
      {topGroups.map((e) => (
        <a class="chip group-chip" href={`${base}/group/${e.group.id}`}>
          {e.group.en} <span class="dim">{e.total}</span>
        </a>
      ))}
    </nav>
    <p class="note dim">
      Each group page splits the group's own dates from its members' solo and unit shows.
    </p>
  </section>

  <section class="wrap block">
    <h2>What this does — and doesn't</h2>
    <div class="grid two">
      <article class="card">
        <h3>Group and member, separately</h3>
        <p class="muted">
          A group's arena tour and a member's solo fan-con are different plans. Member
          rosters come from official cast records, not from guesswork.
        </p>
      </article>
      <article class="card">
        <h3>Venue detail that travels</h3>
        <p class="muted">
          Capacity, halls, wheelchair seating and map links that work in Korea — where
          Google Maps can't give driving directions.
        </p>
      </article>
      <article class="card">
        <h3>Links, not transactions</h3>
        <p class="muted">
          We point at the seller the organiser named. No ticket sales, no payments,
          no accounts.
        </p>
      </article>
      <article class="card">
        <h3>No on-sale alerts</h3>
        <p class="muted">
          KOPIS registers a show only after sales begin, so this site can't tell you when
          tickets drop. We'd rather say so than pretend.
        </p>
      </article>
    </div>
    <p class="note dim">
      Not just idols: the full KOPIS popular-music catalogue —
      {snapshot.performances.length.toLocaleString()} performances including indie, jazz
      and trot — is at <a href={`${base}/all`}>all popular music</a>.
    </p>
  </section>
</Base>

<style>
  .hero { padding-block: 64px 30px; }
  .lede { font-size: clamp(1.02rem, 2vw, 1.2rem); max-width: 60ch; margin-block: 0 0.7rem; }
  .src { max-width: 62ch; font-size: 0.9rem; }

  .stats { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .stat {
    display: flex; flex-direction: column; gap: 2px;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 14px 20px; text-decoration: none; min-width: 150px;
  }
  a.stat:hover { border-color: var(--neon-purple); }
  .stat-n { font-size: 1.8rem; font-weight: 800; color: var(--neon-cyan); line-height: 1.1; }
  .stat-l { font-size: 0.82rem; }

  .bar { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .bar h2 { margin: 0; }
  .bar .dim { font-size: 0.85rem; }
  .bar .dim a { color: var(--neon-cyan); text-decoration: none; }
  .bar .dim a:hover { text-decoration: underline; }
  .freshness { font-size: 0.85rem; }

  section.wrap > .bar { margin: 28px 0 18px; }

  .more { margin-top: 26px; }
  .btn {
    display: inline-block; padding: 12px 22px; border-radius: var(--radius-sm);
    background: var(--grad-stage); color: #12001a; font-weight: 750; text-decoration: none;
  }
  .btn:hover { filter: brightness(1.12); color: #12001a; }

  .block { margin-top: 52px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .group-chip { text-decoration: none; font-weight: 600; }
  .group-chip:hover { color: var(--text); border-color: var(--neon-purple); }

  .note { font-size: 0.86rem; margin-top: 14px; max-width: 70ch; }
  .note a { color: var(--neon-cyan); }

  .grid.two { grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); }
  .grid.two h3 { margin-bottom: 6px; }
  .grid.two p { margin: 0; font-size: 0.9rem; }
</style>
